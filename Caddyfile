{
    auto_https off
}

:8080 {
    bind 0.0.0.0

    log {
        output stdout
        format console
    }

    # Liveness endpoint Northflank
    handle /healthz {
        respond "ok" 200
    }

    # Временная проверка pbseed
    handle_path /__probe-pbseed* {
        reverse_proxy 127.0.0.1:18080 {
            header_up Host pbseed.pzlb.ru
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
        }
    }

    # Временная проверка панели
    handle_path /__probe* {
        reverse_proxy 127.0.0.1:18080 {
            header_up Host panel.pzlb.ru
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
        }
    }

    # WebSocket-туннель rathole
    @rathole_ws {
        header Upgrade websocket
    }

    handle @rathole_ws {
        reverse_proxy 127.0.0.1:2333
    }

    # Обычный трафик через домашний Traefik
    handle {
        reverse_proxy 127.0.0.1:18080 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
        }
    }
}
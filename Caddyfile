{
    auto_https off
}

:8080 {
    bind 0.0.0.0

    log {
        output stdout

        format filter {
            wrap json
            request>headers>X-Origin-Auth delete
            request>headers>Cookie delete
        }
    }

    # Health check Northflank
    handle /healthz {
        respond "ok" 200
    }

    # Только control channel rathole.
    # Остальные WebSocket-запросы, включая Frigate, идут в домашний Proxy.
    @rathole_control {
        host p01--northflank-rathole--xgl97grbggxj.code.run
        header Upgrade websocket
    }

    handle @rathole_control {
        reverse_proxy 127.0.0.1:2333
    }

    # Временный режим: весь остальной HTTP/WebSocket-трафик
    # пропускается без X-Origin-Auth
    handle {
        reverse_proxy 127.0.0.1:18080 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
        }
    }
}